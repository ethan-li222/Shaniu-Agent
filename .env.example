SHANIU_PROVIDER=demo
SHANIU_HOST=127.0.0.1
SHANIU_PORT=8011
# Change to compatible to call the configured real model.
SHANIU_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
SHANIU_API_KEY=
SHANIU_MODEL=xopglm53
SHANIU_STREAM=true
SHANIU_MAX_TOKENS=1024
# Separate output budget for tool planning (includes model reasoning when applicable).
SHANIU_TOOL_MAX_TOKENS=4096
# Optional checkout used by GPU rendering; not required for text/demo mode.
SHANIU_AIAVATAR_PATH=../AIAvatar
SHANIU_TTS_PROVIDER=windows
SHANIU_TTS_VOICE=zh-CN-XiaoxiaoNeural
SHANIU_TTS_FALLBACK=true
# Natural punctuation pauses and subtle emotion pitch; edge recommended for voice quality.
SHANIU_TTS_NATURAL=true
# Enable native agent tools for the existing MoneyPrinterTurbo API.
SHANIU_MPT_ENABLED=false
SHANIU_MPT_URL=http://127.0.0.1:8080
# Relative paths are resolved against this repository, not the shell directory.
# Included engine; no separate checkout is needed. --project can override it.
SHANIU_MPT_PROJECT=vendor/moneyprinter
# Private config is created from a clean template, never committed.
SHANIU_MPT_CONFIG=data/moneyprinter/config.toml
# Optional absolute/path relative to repo for an installed CJK subtitle font.
SHANIU_MPT_FONT_FILE=

# MoneyPrinter's own LLM, independent of Shaniu's conversation model.
# compatible: Xunfei / DeepSeek / Qwen / local compatible endpoints.
# upstream: use the original MoneyPrinter config.toml instead.
SHANIU_MPT_LLM_PROVIDER=compatible
SHANIU_MPT_LLM_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
SHANIU_MPT_LLM_MODEL=xopglm53
# Blank reuses SHANIU_API_KEY; set a separate key when switching providers.
SHANIU_MPT_LLM_API_KEY=

# Edge online voice; automatically fall back to an installed Windows zh-CN desktop voice.
# Set provider=windows to always use local speech; false disables fallback.
SHANIU_MPT_TTS_PROVIDER=edge
SHANIU_MPT_TTS_FALLBACK=true

